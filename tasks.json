{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Run Backend Server",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "type": "shell",
      "label": "Run Frontend Server",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Start DevSync (Backend + Frontend)",
      "dependsOn": [
        "Run Backend Server",
        "Run Frontend Server"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
